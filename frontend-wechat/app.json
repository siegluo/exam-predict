    "van-tag": "../../assets/vant/tag/index",
    "van-progress": "../../assets/vant/progress/index",
    "van-notice-bar": "../../assets/vant/notice-bar/index",
    "van-dialog": "../../assets/vant/dialog/index",
    "van-toast": "../../assets/vant/toast/index",
    "van-loading": "../../assets/vant/loading/index",
    "van-switch": "../../assets/vant/switch/index",
    "van-field": "../../assets/vant/field/index",
    "van-picker": "../../assets/vant/picker/index"
