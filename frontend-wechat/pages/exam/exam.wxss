/* pages/exam/exam.wxss - 刷题页样式 */

.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 列表模式 */
.exam-list-header {
  padding: 30rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-tabs {
  display: flex;
  margin-bottom: 24rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.filter-tab.active {
  color: #4A90E2;
  border-bottom-color: #4A90E2;
}

.start-btn {
  width: 100%;
}

/* 题目列表 */
.question-list {
  padding: 30rpx;
}

.question-card {
  margin-bottom: 24rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.question-type {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.question-difficulty {
  display: flex;
}

.star {
  color: #E8E8E8;
  font-size: 24rpx;
  margin-left: 4rpx;
}

.star.active {
  color: #FF9900;
}

.question-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.question-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.question-hash {
  font-size: 24rpx;
  color: #999;
}

.question-actions {
  display: flex;
  gap: 24rpx;
}

.action-icon {
  font-size: 32rpx;
  color: #999;
}

/* 答题模式 */
.exam-header {
  position: sticky;
  top: 0;
  background: #FFFFFF;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.exam-timer {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.timer-icon {
  font-size: 32rpx;
}

.timer-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A90E2;
}

.exam-progress {
  flex: 1;
  margin: 0 30rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  display: block;
  text-align: center;
  margin-bottom: 8rpx;
}

.exam-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #4A90E2;
}

/* 题目内容区 */
.exam-content {
  padding: 30rpx;
}

.question-type-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 40rpx;
}

/* 选项列表 */
.options-list {
  margin-bottom: 30rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.option-item.selected {
  border-color: #4A90E2;
  background: rgba(74, 144, 226, 0.05);
}

.option-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  flex-shrink: 0;
}

.option-item.selected .option-letter {
  background: #4A90E2;
  color: #FFFFFF;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.option-check {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4A90E2;
}

/* 解析区域 */
.analysis-section {
  background: #FFF9E6;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 30rpx;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF9900;
  margin-bottom: 16rpx;
}

.analysis-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 底部操作栏 */
.exam-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.footer-btn {
  padding: 20rpx 32rpx;
  background: #F5F5F5;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #666;
}

.footer-btn.submit {
  background: linear-gradient(135deg, #4A90E2, #67B3E8);
  color: #FFFFFF;
}

.footer-btn-group {
  display: flex;
  gap: 16rpx;
}

.footer-btn.small {
  padding: 20rpx 24rpx;
  font-size: 26rpx;
}

/* 答题卡 */
.answer-sheet {
  width: 600rpx;
  min-height: 100vh;
  background: #FFFFFF;
  padding: 30rpx;
  box-sizing: border-box;
}

.answer-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.close-btn {
  font-size: 48rpx;
  color: #999;
}

.answer-sheet-stats {
  display: flex;
  gap: 30rpx;
  margin-bottom: 30rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.stat-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #E8E8E8;
}

.stat-dot.answered {
  background: #43AF53;
}

.stat-dot.uncertain {
  background: #FF9900;
}

.answer-sheet-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.answer-sheet-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
}

.answer-sheet-item.answered {
  background: #43AF53;
  color: #FFFFFF;
}

.answer-sheet-item.uncertain {
  background: #FF9900;
  color: #FFFFFF;
}

/* 结果模式 */
.result-container {
  padding: 30rpx;
}

.result-header {
  background: linear-gradient(135deg, #4A90E2, #67B3E8);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #FFFFFF;
  margin-bottom: 30rpx;
}

.result-score {
  text-align: center;
  margin-bottom: 30rpx;
}

.score-circle {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.score-value {
  font-size: 64rpx;
  font-weight: 700;
}

.score-label {
  font-size: 28rpx;
  opacity: 0.9;
}

.result-stats {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 24rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.result-detail {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.result-detail-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.result-questions {
  max-height: 600rpx;
  overflow-y: auto;
}

.result-question-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.result-question-item:last-child {
  border-bottom: none;
}

.result-question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.result-question-num {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.result-question-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.result-actions {
  display: flex;
  gap: 24rpx;
}

.result-actions button {
  flex: 1;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 工具类 */
.text-primary {
  color: #4A90E2;
}
