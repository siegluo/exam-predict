<!-- pages/exam/exam.wxml - 刷题页 -->
<view class="page">
  <!-- 列表模式 -->
  <block wx:if="{{mode === 'list'}}">
    <view class="exam-list-header">
      <view class="filter-tabs">
        <view 
          class="filter-tab {{filterType === 'all' ? 'active' : ''}}" 
          bindtap="onFilterType" 
          data-type="all"
        >全部</view>
        <view 
          class="filter-tab {{filterType === 'single' ? 'active' : ''}}" 
          bindtap="onFilterType" 
          data-type="single"
        >单选</view>
        <view 
          class="filter-tab {{filterType === 'multiple' ? 'active' : ''}}" 
          bindtap="onFilterType" 
          data-type="multiple"
        >多选</view>
        <view 
          class="filter-tab {{filterType === 'case' ? 'active' : ''}}" 
          bindtap="onFilterType" 
          data-type="case"
        >案例</view>
      </view>
      
      <button class="btn-primary start-btn" bindtap="startExam" disabled="{{questions.length === 0}}">
        开始练习
      </button>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{isLoading}}" class="loading-container">
      <van-loading type="spinner" size="48rpx">加载中...</van-loading>
    </view>

    <!-- 题目列表 -->
    <view wx:else class="question-list">
      <block wx:for="{{questions}}" wx:key="id">
        <view class="question-card card" bindtap="goToQuestion" data-index="{{index}}">
          <view class="question-header">
            <view class="question-type">
              <van-tag type="{{item.type === 'single' ? 'primary' : item.type === 'multiple' ? 'warning' : 'success'}}">
                {{item.type === 'single' ? '单选' : item.type === 'multiple' ? '多选' : '案例'}}
              </van-tag>
              <van-tag plain>{{item.chapter}}</van-tag>
            </view>
            <view class="question-difficulty">
              <block wx:for="{{5}}" wx:for-item="star" wx:key="*this">
                <text class="star {{star <= item.difficulty ? 'active' : ''}}">★</text>
              </block>
            </view>
          </view>
          
          <view class="question-content">
            <text>{{item.content}}</text>
          </view>
          
          <view class="question-footer">
            <text class="question-hash">#{{item.id}}</text>
            <view class="question-actions">
              <text class="action-icon" bindtap="toggleFavorite" data-id="{{item.id}}">☆</text>
              <text class="action-icon" catchtap="shareQuestion">↗</text>
            </view>
          </view>
        </view>
      </block>
      
      <view wx:if="{{questions.length === 0}}" class="empty-state">
        <text class="empty-icon">📝</text>
        <text class="empty-text">暂无题目</text>
      </view>
    </view>
  </block>

  <!-- 答题模式 -->
  <block wx:if="{{mode === 'exam'}}">
    <!-- 顶部导航 -->
    <view class="exam-header">
      <view class="exam-timer">
        <text class="timer-icon">⏱️</text>
        <text class="timer-text">{{formattedTime}}</text>
      </view>
      
      <view class="exam-progress">
        <text class="progress-text">{{currentIndex + 1}} / {{questions.length}}</text>
        <view class="progress-bar">
          <view class="progress-bar-inner" style="width: {{(currentIndex + 1) / questions.length * 100}}%"></view>
        </view>
      </view>
      
      <view class="exam-actions">
        <text class="action-btn" bindtap="toggleAnswerSheet">答题卡</text>
        <text class="action-btn" bindtap="submitPaper">交卷</text>
      </view>
    </view>

    <!-- 题目内容 -->
    <view class="exam-content">
      <view class="question-type-bar">
        <van-tag type="{{currentQuestion.type === 'single' ? 'primary' : currentQuestion.type === 'multiple' ? 'warning' : 'success'}}">
          {{currentQuestion.type === 'single' ? '单选题' : currentQuestion.type === 'multiple' ? '多选题' : '案例分析'}}
        </van-tag>
        <text class="question-hash">#{{currentQuestion.id}}</text>
      </view>
      
      <view class="question-text">
        <text>{{currentQuestion.content}}</text>
      </view>

      <!-- 选项列表 -->
      <view class="options-list">
        <block wx:for="{{currentQuestion.options}}" wx:key="id">
          <view 
            class="option-item {{userAnswers[currentIndex] === item.id || (userAnswers[currentIndex] && userAnswers[currentIndex].includes(item.id)) ? 'selected' : ''}}"
            bindtap="onSelectOption"
            data-option-id="{{item.id}}"
          >
            <view class="option-letter">
              <text>{{item.id}}</text>
            </view>
            <view class="option-text">
              <text>{{item.text}}</text>
            </view>
            <view class="option-check">
              <text wx:if="{{userAnswers[currentIndex] === item.id}}">✓</text>
              <text wx:elif="{{userAnswers[currentIndex] && userAnswers[currentIndex].includes(item.id)}}">✓</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 解析区域 -->
      <view wx:if="{{showAnalysis}}" class="analysis-section">
        <view class="analysis-title">答案解析</view>
        <view class="analysis-content">
          <text>{{currentQuestion.analysis}}</text>
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="exam-footer">
      <view class="footer-btn" bindtap="prevQuestion">
        <text>← 上一题</text>
      </view>
      
      <view class="footer-btn-group">
        <view class="footer-btn small" bindtap="markUncertain">
          <text>标记</text>
        </view>
        <view class="footer-btn small" bindtap="favoriteQuestion">
          <text>收藏</text>
        </view>
      </view>
      
      <view class="footer-btn {{currentIndex === questions.length - 1 ? 'submit' : ''}}" bindtap="{{currentIndex === questions.length - 1 ? 'submitPaper' : 'nextQuestion'}}">
        <text>{{currentIndex === questions.length - 1 ? '交卷' : '下一题 →'}}</text>
      </view>
    </view>

    <!-- 答题卡弹窗 -->
    <van-popup show="{{showAnswerSheet}}" position="right" bind:close="toggleAnswerSheet">
      <view class="answer-sheet">
        <view class="answer-sheet-header">
          <text>答题卡</text>
          <text class="close-btn" bindtap="toggleAnswerSheet">×</text>
        </view>
        
        <view class="answer-sheet-stats">
          <view class="stat-item">
            <view class="stat-dot answered"></view>
            <text>已答 {{stats.answered}}</text>
          </view>
          <view class="stat-item">
            <view class="stat-dot uncertain"></view>
            <text>标记</text>
          </view>
        </view>
        
        <view class="answer-sheet-grid">
          <block wx:for="{{questions}}" wx:key="index">
            <view 
              class="answer-sheet-item {{userAnswers[index] ? 'answered' : ''}} {{userAnswers['uncertain_' + index] ? 'uncertain' : ''}}"
              bindtap="goToQuestion"
              data-index="{{index}}"
            >
              {{index + 1}}
            </view>
          </block>
        </view>
      </view>
    </van-popup>
  </block>

  <!-- 结果模式 -->
  <block wx:if="{{mode === 'result'}}">
    <view class="result-container">
      <view class="result-header">
        <view class="result-score">
          <view class="score-circle">
            <text class="score-value">{{stats.correct}}</text>
            <text class="score-label">正确</text>
          </view>
        </view>
        
        <view class="result-stats">
          <view class="stat-row">
            <text>正确率</text>
            <text class="text-primary">{{stats.total > 0 ? Math.round(stats.correct / stats.total * 100) : 0}}%</text>
          </view>
          <view class="stat-row">
            <text>总题数</text>
            <text>{{stats.total}}</text>
          </view>
          <view class="stat-row">
            <text>已答题数</text>
            <text>{{stats.answered}}</text>
          </view>
          <view class="stat-row">
            <text>用时</text>
            <text>{{formattedTime}}</text>
          </view>
        </view>
      </view>
      
      <view class="result-detail">
        <view class="result-detail-title">答题详情</view>
        <view class="result-questions">
          <block wx:for="{{questions}}" wx:key="id">
            <view class="result-question-item">
              <view class="result-question-header">
                <text class="result-question-num">第{{index + 1}}题</text>
                <van-tag type="{{userAnswers[index] ? 'success' : 'default'}}">
                  {{userAnswers[index] ? '已答' : '未答'}}
                </van-tag>
              </view>
              <view class="result-question-content">
                <text>{{item.content}}</text>
              </view>
            </view>
          </block>
        </view>
      </view>
      
      <view class="result-actions">
        <button class="btn-secondary" bindtap="retake">重新练习</button>
        <button class="btn-primary" bindtap="continueExam">继续学习</button>
      </view>
    </view>
  </block>
</view>
