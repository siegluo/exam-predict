/* pages/notify/notify.wxss - 通知设置页样式 */

.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 30rpx;
}

/* 区块 */
.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
}

/* 设置列表 */
.setting-list {
  margin-top: 10rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
}

.setting-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.setting-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #4A90E2;
}

.arrow {
  color: #CCC;
}

/* 免打扰时间设置 */
.quiet-time-settings {
  padding-left: 30rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.quiet-time-settings .setting-item {
  padding: 20rpx 0;
}

/* 重置按钮 */
.reset-section {
  margin-top: 60rpx;
  padding-bottom: 40rpx;
}

.btn-reset {
  width: 100%;
  padding: 24rpx 0;
  background: #FFFFFF;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #999;
}

.btn-reset:active {
  background: #F5F5F5;
}
