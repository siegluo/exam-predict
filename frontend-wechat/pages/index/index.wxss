/* pages/index/index.wxss - 首页样式 */

.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 头部样式 */
.header {
  position: relative;
  padding: 0 30rpx 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #67B3E8 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding-top: 20rpx;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background: #E8E8E8;
}

.user-detail {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.exam-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

/* 倒计时卡片 */
.countdown-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 226, 0.2);
}

.countdown-main {
  display: flex;
  flex-direction: column;
}

.countdown-label {
  font-size: 26rpx;
  color: #666;
}

.countdown-days {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.days-number {
  font-size: 72rpx;
  font-weight: 700;
  color: #4A90E2;
  line-height: 1;
}

.days-unit {
  font-size: 32rpx;
  color: #4A90E2;
  margin-left: 8rpx;
}

.countdown-date {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 26rpx;
  color: #999;
}

.countdown-date .icon {
  font-size: 40rpx;
  margin-top: 10rpx;
}

/* 统计卡片 */
.stats-card {
  margin: -20rpx 30rpx 24rpx;
  position: relative;
  z-index: 2;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.stats-item {
  width: 50%;
  padding: 10rpx;
  box-sizing: border-box;
}

.stats-card-inner {
  background: #F8FAFF;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.stats-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A90E2;
  display: block;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 任务卡片 */
.tasks-card,
.weak-points-card,
.quick-entry-card,
.notifications-card {
  margin: 0 30rpx 24rpx;
}

.task-list {
  margin-top: 10rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.task-item:last-child {
  border-bottom: none;
}

.task-progress-ring {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  position: relative;
  overflow: hidden;
}

.progress-ring-inner {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, #4A90E2, #67B3E8);
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #666;
  z-index: 1;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.progress-bar {
  width: 100%;
  height: 10rpx;
  background: #E8E8E8;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #67B3E8);
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

.progress-bar-inner.danger {
  background: linear-gradient(90deg, #ED4C4C, #FF6B6B);
}

.progress-bar.small {
  height: 8rpx;
  margin-top: 10rpx;
}

.task-arrow {
  color: #CCC;
  font-size: 28rpx;
  margin-left: 20rpx;
}

/* 薄弱点列表 */
.weak-points-list {
  margin-top: 10rpx;
}

.weak-point-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.weak-point-item:last-child {
  border-bottom: none;
}

.weak-point-left {
  flex: 1;
}

.weak-point-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.weak-point-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
}

.mastery-value {
  font-size: 32rpx;
  font-weight: 600;
}

.mastery-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 快速入口 */
.quick-entry-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.quick-entry-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.quick-entry-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.quick-entry-name {
  font-size: 26rpx;
  color: #666;
}

/* 通知列表 */
.notification-list {
  margin-top: 10rpx;
}

.notification-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.notification-item:last-child {
  border-bottom: none;
}

.notification-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.notification-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.notification-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.notification-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 底部间距 */
.bottom-space {
  height: 40rpx;
}

/* 登录弹窗 */
.login-modal-content {
  padding: 40rpx 30rpx;
  text-align: center;
}

.login-modal-content text {
  display: block;
  margin-bottom: 30rpx;
  color: #666;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.text-gray {
  color: #999;
}

.text-primary {
  color: #4A90E2;
  font-size: 28rpx;
}

.text-success {
  color: #43AF53;
}

.text-danger {
  color: #ED4C4C;
}
