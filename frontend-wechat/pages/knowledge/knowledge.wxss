/* pages/knowledge/knowledge.wxss - 知识图谱页样式 */

.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 30rpx;
}

/* 搜索框 */
.search-bar {
  margin-bottom: 30rpx;
}

.search-input {
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

/* 章节列表 */
.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.chapter-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.chapter-info {
  flex: 1;
}

.chapter-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.chapter-stats {
  display: flex;
  gap: 20rpx;
}

.stat {
  font-size: 24rpx;
  color: #999;
}

.chapter-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

/* 预测概率标签 */
.probability-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.probability-tag.high {
  background: rgba(237, 76, 76, 0.1);
  color: #ED4C4C;
}

.probability-tag.medium {
  background: rgba(255, 153, 0, 0.1);
  color: #FF9900;
}

.probability-tag.low {
  background: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
}

.tag-label {
  font-size: 20rpx;
  font-weight: normal;
  margin-top: 4rpx;
}

/* 掌握度 */
.mastery-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 200rpx;
}

.mastery-label {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

.mastery-value {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.progress-bar {
  flex: 1;
  height: 10rpx;
  background: #E8E8E8;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #67B3E8);
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

/* 知识点列表 */
.points-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.back-btn {
  padding: 10rpx 0;
  margin-right: 20rpx;
}

.back-btn text {
  font-size: 28rpx;
  color: #4A90E2;
}

.chapter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.points-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.point-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.point-info {
  flex: 1;
}

.point-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.point-questions {
  font-size: 24rpx;
  color: #999;
}

.point-right {
  display: flex;
  gap: 16rpx;
}

.probability-badge,
.mastery-badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.probability-badge.high {
  background: rgba(237, 76, 76, 0.1);
  color: #ED4C4C;
}

.probability-badge.medium {
  background: rgba(255, 153, 0, 0.1);
  color: #FF9900;
}

.probability-badge.low {
  background: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
}

.mastery-badge.good {
  background: rgba(67, 175, 83, 0.1);
  color: #43AF53;
}

.mastery-badge.medium {
  background: rgba(255, 153, 0, 0.1);
  color: #FF9900;
}

.mastery-badge.poor {
  background: rgba(237, 76, 76, 0.1);
  color: #ED4C4C;
}

/* 详情页 */
.detail-header {
  margin-bottom: 20rpx;
}

.detail-content {
  padding-bottom: 100rpx;
}

.detail-title-section {
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.detail-chapter {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 24rpx;
}

.detail-tags {
  display: flex;
  gap: 40rpx;
}

.tag-item {
  display: flex;
  flex-direction: column;
}

.tag-value {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

/* 概述 */
.detail-summary {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.summary-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 核心概念 */
.detail-key-concepts {
  margin-bottom: 24rpx;
}

.concepts-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.concept-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background: #F8FAFF;
  border-radius: 12rpx;
}

.concept-icon {
  margin-right: 16rpx;
  font-size: 28rpx;
}

.concept-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

/* 相关知识点 */
.detail-related {
  margin-bottom: 24rpx;
}

.related-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.related-tag {
  padding: 12rpx 24rpx;
  background: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
  border-radius: 44rpx;
  font-size: 26rpx;
}

/* 学习按钮 */
.study-btn {
  position: fixed;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
}

/* 文字颜色 */
.text-danger {
  color: #ED4C4C;
}

.text-warning {
  color: #FF9900;
}

.text-success {
  color: #43AF53;
}
