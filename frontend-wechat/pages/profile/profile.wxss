/* pages/profile/profile.wxss - 个人中心页样式 */

.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 用户信息头部 */
.profile-header {
  position: relative;
  padding: 0 30rpx 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #67B3E8 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.user-info-section {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding-top: 40rpx;
}

.avatar-wrapper {
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background: #E8E8E8;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-top: 6rpx;
}

.vip-status {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 44rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.vip-status.active {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #FFFFFF;
}

.vip-expire {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.remain-days {
  font-weight: 600;
}

/* 统计区块 */
.stats-section {
  margin: -20rpx 30rpx 24rpx;
  position: relative;
  z-index: 2;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 50%;
  text-align: center;
  padding: 20rpx 0;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90E2;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 趋势区块 */
.trend-section {
  margin: 0 30rpx 24rpx;
}

.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding-top: 20rpx;
}

.trend-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-bar-wrapper {
  height: 120rpx;
  display: flex;
  align-items: flex-end;
}

.trend-bar {
  width: 40rpx;
  background: linear-gradient(180deg, #4A90E2, #67B3E8);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 20rpx;
}

.trend-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.trend-value {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 快捷操作 */
.actions-section {
  margin: 0 30rpx 24rpx;
}

.actions-grid {
  display: flex;
  flex-wrap: wrap;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 10rpx;
}

.action-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-name {
  font-size: 24rpx;
  color: #666;
}

/* VIP推广 */
.vip-promo {
  margin: 0 30rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
}

.promo-content {
  flex: 1;
}

.promo-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.promo-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.promo-btn {
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  font-size: 26rpx;
  color: #FFA500;
  font-weight: 600;
}

/* 设置区块 */
.settings-section {
  margin: 0 30rpx 24rpx;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.settings-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.settings-arrow {
  font-size: 28rpx;
  color: #CCC;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #999;
}

/* 文字颜色 */
.text-danger {
  color: #ED4C4C;
}
