/* app.wxss - 全局样式 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  background-color: #F5F5F5;
}

/* 容器样式 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-container {
  padding: 30rpx;
  min-height: calc(100vh - 100rpx);
}

/* 卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title .icon {
  margin-right: 12rpx;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #4A90E2, #67B3E8);
  color: #FFFFFF;
  border: none;
  border-radius: 44rpx;
  padding: 24rpx 60rpx;
  font-size: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: #FFFFFF;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
  border-radius: 44rpx;
  padding: 22rpx 60rpx;
  font-size: 30rpx;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-primary {
  background: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
}

.tag-danger {
  background: rgba(237, 76, 76, 0.1);
  color: #ED4C4C;
}

.tag-success {
  background: rgba(67, 175, 83, 0.1);
  color: #43AF53;
}

.tag-warning {
  background: rgba(255, 153, 0, 0.1);
  color: #FF9900;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 16rpx;
  background: #E8E8E8;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2, #67B3E8);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.list-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: rgba(74, 144, 226, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 40rpx;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.list-item-desc {
  font-size: 24rpx;
  color: #999;
}

/* 统计数据 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.stats-item {
  width: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.stats-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stats-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #4A90E2;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 60rpx;
}

.empty-state-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}

/* 分割线 */
.divider {
  height: 20rpx;
  background: #F5F5F5;
  margin: 0 -30rpx;
}

/* 文本样式 */
.text-primary {
  color: #4A90E2;
}

.text-danger {
  color: #ED4C4C;
}

.text-success {
  color: #43AF53;
}

.text-warning {
  color: #FF9900;
}

.text-gray {
  color: #999;
}

.text-bold {
  font-weight: 600;
}

.text-center {
  text-align: center;
}

/* Flex 工具类 */
.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.gap-10 {
  gap: 10rpx;
}

.gap-20 {
  gap: 20rpx;
}

.gap-30 {
  gap: 30rpx;
}

/* 间距工具类 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }
